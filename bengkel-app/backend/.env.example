# ============================================================
# ENVIRONMENT VARIABLES — Backend Express.js
# Salin file ini menjadi .env dan isi dengan nilai asli.
# JANGAN pernah commit file .env ke version control.
# ============================================================

# Supabase Project Config
# Dapatkan dari: Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Config
# Buat string acak minimal 64 karakter sebagai secret
JWT_SECRET=ganti_dengan_string_acak_sangat_panjang_dan_aman_minimal_64_karakter
JWT_EXPIRES_IN=8h

# Server Config
PORT=5000
NODE_ENV=development

# CORS — URL frontend yang diizinkan mengakses API
CORS_ORIGIN=http://localhost:3000
