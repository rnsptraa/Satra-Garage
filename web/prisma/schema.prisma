// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PELANGGAN
  ADMIN
  SUPER_ADMIN
}

enum StatusBooking {
  Menunggu
  Diproses
  Selesai
  Dibatalkan
}

enum StatusPembayaran {
  Lunas
  Belum_Lunas @map("Belum Lunas")
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String      // Hashed password for authentication
  nama       String
  no_telepon String?
  role       Role        @default(PELANGGAN)
  createdAt  DateTime    @default(now())
  
  kendaraan  Kendaraan[]
  booking    Booking[]
  transaksi  Transaksi[] @relation("AdminCashier")

  @@map("users")
}

model Kendaraan {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platNomor  String    @unique @map("plat_nomor")
  merk       String
  tipe       String
  tahun      Int?
  createdAt  DateTime  @default(now())

  booking    Booking[]

  @@map("kendaraan")
}

model Layanan {
  id            String    @id @default(uuid())
  namaLayanan   String    @map("nama_layanan")
  deskripsi     String?
  harga         Decimal
  estimasiWaktu Int?      @map("estimasi_waktu") // in minutes
  createdAt     DateTime  @default(now())

  booking       Booking[]

  @@map("layanan")
}

model Booking {
  id             String        @id @default(uuid())
  pelangganId    String        @map("pelanggan_id")
  pelanggan      User          @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  kendaraanId    String        @map("kendaraan_id")
  kendaraan      Kendaraan     @relation(fields: [kendaraanId], references: [id], onDelete: Cascade)
  layananId      String        @map("layanan_id")
  layanan        Layanan       @relation(fields: [layananId], references: [id], onDelete: Cascade)
  tanggalBooking DateTime      @map("tanggal_booking")
  status         StatusBooking @default(Menunggu)
  catatan        String?       @db.Text
  createdAt      DateTime      @default(now())

  transaksi      Transaksi?

  @@map("booking")
}

model Transaksi {
  id               String           @id @default(uuid())
  bookingId        String           @unique @map("booking_id")
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  adminId          String?          @map("admin_id")
  admin            User?            @relation("AdminCashier", fields: [adminId], references: [id], onDelete: SetNull)
  totalBayar       Decimal          @map("total_bayar")
  metodePembayaran String?          @map("metode_pembayaran")
  statusPembayaran StatusPembayaran @default(Lunas) @map("status_pembayaran")
  tanggalBayar     DateTime         @default(now()) @map("tanggal_bayar")

  @@map("transaksi")
}
